{
  "name": "sonora",
  "private": true,
  "packageManager": "bun@1.4.5",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @sonora/web dev",
    "build": "bun --filter @sonora/web build",
    "deploy": "bun --filter @sonora/api db:migrate:remote && bun --filter @sonora/web deploy",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun --filter '*' test",
    "lint": "biome check .",
    "fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "typescript": "^7.0.2"
  }
}
