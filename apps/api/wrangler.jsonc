{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sonora",
  "main": "./src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // "free" fits the free plan's 10 ms CPU limit; set "owasp" on Workers Paid (accounts upgrade on next login).
  "vars": {
    "PASSWORD_PROFILE": "free",
    "B2_ENDPOINT": "s3.eu-central-003.backblazeb2.com",
    "B2_BUCKET": "sonora-files"
  },
  // Set with `wrangler secret put`; locally in apps/api/.dev.vars.
  "secrets": { "required": ["B2_KEY_ID", "B2_APP_KEY"] },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "USER_HUB", "class_name": "UserHub" },
      { "name": "CALL_ROOM", "class_name": "CallRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UserHub"] },
    { "tag": "v2", "new_sqlite_classes": ["CallRoom"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sonora",
      "database_id": "396b0e7a-329f-44c1-9a44-acacea108c25",
      "migrations_dir": "./migrations"
    }
  ]
}
